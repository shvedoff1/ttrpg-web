# ── JWT ─────────────────────────────────────────────────────────────────────
# Обязательно смените в production! Сгенерировать: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-in-production

# ── Database ─────────────────────────────────────────────────────────────────
# По умолчанию SQLite (resources/ttrpg.db). Для PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/ttrpg

# ── Google OAuth ─────────────────────────────────────────────────────────────
# Получить на https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ── Cookies ──────────────────────────────────────────────────────────────────
# Установить "true" в production (требует HTTPS)
COOKIE_SECURE=false
